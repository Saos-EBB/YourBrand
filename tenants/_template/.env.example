# Mandanten-Env — Vorlage fuer scripts/tenant.sh, das daraus beim ersten
# "up" tenants/<slug>/.env erzeugt (gitignored). Die __PLATZHALTER__ fuellt
# das Skript, den Rest pro Mandant selbst eintragen.
#
# Im Backend-, Worker- und Init-Container wird diese Datei als /app/.env
# gemountet — backend/.env (default-Mandant) ist dort NICHT sichtbar. Alles,
# was das Backend liest und nicht in docker-compose.tenant.yml steht, muss
# also hier stehen.

TENANT_SLUG=__SLUG__
BACKEND_PORT=__BACKEND_PORT__
FRONTEND_PORT=__FRONTEND_PORT__

# --- Secrets, pro Mandant generiert ------------------------------------------
# EMAIL_SALT und APP_ENCRYPTION_KEY NIE aendern, sobald Nutzer existieren:
# E-Mails sind damit verschluesselt (AES-256) bzw. gehasht (Login-Lookup) —
# ein neuer Wert macht alle bestehenden Konten unlesbar bzw. unauffindbar.
JWT_SECRET=__JWT_SECRET__
EMAIL_SALT=__EMAIL_SALT__
APP_ENCRYPTION_KEY=__APP_ENCRYPTION_KEY__

# --- Externe Dienste, pro Mandant eigene Accounts ---------------------------
RESEND_API_KEY=re_your_resend_api_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# --- Laufzeit ---------------------------------------------------------------
NODE_ENV=development
COOKIE_SAMESITE=lax
LOADTEST_MODE=false
