# Browser-facing (baked into the client bundle) — the backend port published to the host.
# Demo-Hosting (Vercel-Frontend + ngrok-Tunnel, siehe backend/docs/deployment/demo-hosting.md):
# NEXT_PUBLIC_API_URL=https://<static-domain>.ngrok-free.app/api/v1
# NEXT_PUBLIC_WS_URL=wss://<static-domain>.ngrok-free.app
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3000

# Server-to-server (Next.js server, e.g. the /uploads rewrite in next.config.ts).
# Plain localhost when the frontend runs directly on the host.
# docker-compose overrides this to http://nestjs:3000 for the containerized frontend.
# Auf Vercel (Demo-Hosting): auf dieselbe ngrok-URL wie NEXT_PUBLIC_API_URL setzen
# (ohne /api/v1-Suffix), sonst laeuft der /uploads-Rewrite gegen ein unerreichbares
# localhost auf Vercels Servern.
BACKEND_INTERNAL_URL=http://localhost:3000

# Offline-Fallback (BackendHealthGate/OfflineFallback), wenn GET /health nicht
# erreichbar ist. MANUELL: echte Werte eintragen, siehe
# backend/docs/deployment/demo-hosting.md.
NEXT_PUBLIC_CONTACT_EMAIL=kontakt@example.com
NEXT_PUBLIC_DEMO_VIDEO_URL=https://loom.com/share/placeholder
# Leer = mailto-Link (Default). Gesetzt = kleines Formular, POSTet dorthin
# (Web3Forms/Formspree-kompatibel) statt mailto.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
