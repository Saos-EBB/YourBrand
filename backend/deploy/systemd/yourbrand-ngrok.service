[Unit]
Description=ngrok tunnel for YourBrand backend (demo hosting)
After=docker.service
Wants=docker.service

[Service]
Type=simple
User=saosgone
Environment=HOME=/home/saosgone
# MANUELL: <your-static-domain> ersetzen (reservierte ngrok Static Domain),
# siehe backend/docs/deployment/demo-hosting.md.
ExecStart=/usr/bin/ngrok http 3000 --url=https://<your-static-domain>.ngrok-free.app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
