# PostgreSQL
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Object Storage (S3-kompatibel: MinIO lokal, R2/B2 in Prod)
# Lokal via docker-compose: MINIO_ROOT_USER/PASSWORD sind auch die S3-Keys.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=yourbrand-media
S3_PUBLIC_URL_BASE=http://localhost:9000/yourbrand-media

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password

# JWT
JWT_SECRET=your-long-random-jwt-secret
EMAIL_SALT=your-random-salt-here

# Resend
RESEND_API_KEY=re_your_resend_api_key

# App
APP_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# Komma-separierte Liste — main.ts, chat.gateway.ts und beef.gateway.ts lesen
# alle drei ueber getCorsOrigins() dieselbe Liste (REST + beide WS-Gateways).
CORS_ORIGIN=http://localhost:3001,https://your-vercel-project.vercel.app,https://saos-repo.vercel.app

# AES-256 encryption key (32 bytes = 64 hex chars)
APP_ENCRYPTION_KEY=your-64-char-hex-encryption-key

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:3001/payment/success
STRIPE_CANCEL_URL=http://localhost:3001/payment/cancel

# Loadtest — NUR in einer dedizierten Loadtest-Umgebung setzen, niemals in Prod.
# Mountet POST /hidden/coin/test-purchase (Stripe-freier Coin-Kauf fuer Loadtests).
LOADTEST_MODE=false

# Steuert nur seed-extra-users/-media/-coin-transactions/-subscriptions-payments
# (loeschen bei true jeweils NUR ihre eigenen seed_user_*/seed_filler/seed:-
# Zeilen und bauen sie neu auf). Der eigentliche Full-Reset auf den kuratierten
# Demo-Zustand (docker-entrypoint.sh -> demo-full-reset.ts) laeuft IMMER, egal
# was hier steht — siehe docs/deployment/demo-hosting.md.
SEED_RESET=true

# --- Deployment (Railway/Vercel-Split) ---------------------------------------
# Nur fuer Deploys relevant, lokal alle weglassen.

# Cookie-Policy fuer das Refresh-Token. Default lax = Frontend und Backend auf
# derselben Site (lokal). Liegen sie auf verschiedenen Domains (Vercel <->
# Railway), muss hier none stehen, sonst schickt der Browser das Cookie nicht
# mit und jede Session bricht beim ersten Refresh ab. none erzwingt Secure,
# funktioniert also nur ueber https.
COOKIE_SAMESITE=lax

# Aktiviert secure Cookies und schaltet TypeORM-Logging ab. Auf Railway setzen.
NODE_ENV=development

# Demo-Seed: Pfad zu demoPfp/ und demoAudio/. Im Container liegen beide unter
# /app. Leer = Seed legt User ohne Bilder/Audio an.
DEMO_MEDIA_PATH=

# Seeds beim Containerstart ausfuehren (nur docker-entrypoint.railway.sh).
# Default true. Auf false setzen, wenn das Image je gegen eine echte DB laeuft.
SEED_ON_BOOT=true
