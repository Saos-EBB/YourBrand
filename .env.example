# Docker Compose variable substitution (${DB_NAME} etc. in docker-compose.yml).
# Must match backend/.env's DB_NAME/DB_USER/DB_PASSWORD/JWT_SECRET — keep both in sync.
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password
JWT_SECRET=your-long-random-jwt-secret
CORS_ORIGIN=http://localhost:3001

# Backend's own public origin — feeds S3_PUBLIC_URL_BASE (media_uploads.file_url
# points at GET /api/v1/media/file/<key> on this origin, which proxies MinIO;
# MinIO itself is never publicly reachable). Default is fine for local docker
# compose; in the ngrok/Vercel demo setup this must be the ngrok Static Domain,
# since MinIO's port isn't tunneled and plain HTTP triggers mixed-content
# blocking on the HTTPS frontend either way.
BACKEND_URL=http://localhost:3000
